{
  "name": "jobloom-server",
  "version": "1.0.0",
  "description": "Jobloom 后端核心与浏览器代理服务",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:dom": "tsx tests/dom-batch.test.ts && tsx tests/delivery-detail-source.test.ts",
    "test:navigation": "tsx tests/cdp-navigation.test.ts",
    "test:session": "tsx tests/browser-session.test.ts && tsx tests/browser-manual-verification.test.ts",
    "test:session-rest": "tsx tests/delivery-browser-cleanup.test.ts && tsx tests/boss-session-rest.test.ts && tsx tests/delivery-session-rest.test.ts && tsx tests/boss-login-signals.test.ts",
    "test:session-rest-browser": "tsx tests/browser-session-rest.test.ts",
    "test:cdp-browser": "tsx tests/cdp-browser.test.ts",
    "test:browser-lifecycle": "tsx tests/browser-lifecycle.test.ts",
    "test:browser": "tsx tests/browser-entry.test.ts",
    "test:batch": "tsx tests/delivery-batch.test.ts",
    "test:delivery-batching": "tsx tests/delivery-batching.test.ts",
    "test:catalog": "tsx tests/boss-catalog.test.ts",
    "test:expectations": "tsx tests/boss-expectation-editor.test.ts && tsx tests/delivery-saved-source.test.ts",
    "test:target-planner": "tsx tests/target-planner.test.ts",
    "test:boss-text": "tsx tests/boss-text.test.ts",
    "test:resume": "tsx tests/resume-text.test.ts",
    "test:llm": "tsx tests/llm-filter-config.test.ts",
    "test:education": "tsx tests/education-filter.test.ts",
    "test:experience": "tsx tests/experience-filter.test.ts",
    "test:language": "tsx tests/language-qualification.test.ts && tsx tests/delivery-language.test.ts",
    "test:review-delivery": "tsx tests/delivery-review.test.ts",
    "test:followup": "tsx tests/followup.test.ts && tsx tests/followup-dom.test.ts",
    "test:work-conditions": "tsx tests/work-conditions.test.ts",
    "test:exclusions": "tsx tests/job-exclusions.test.ts",
    "test:industry": "tsx tests/boss-industry.test.ts",
    "test:delivery-exclusions": "tsx tests/delivery-exclusions.test.ts",
    "test:ai-efficiency": "tsx tests/ai-efficiency.test.ts",
    "test:work-conditions-ui": "tsx tests/work-conditions-ui.test.ts",
    "test:location": "tsx tests/public-location.test.ts && tsx tests/location-coordinates.test.ts && tsx tests/commute-dom.test.ts",
    "test:resume-pdf": "python -X utf8 tests/resume-pdf.test.py && tsx tests/resume-pdf-service.test.ts && tsx tests/resume-boss-upload.test.ts",
    "test:resume-pdf-ui": "tsx tests/resume-pdf-ui.test.ts",
    "test:company-pacing": "npm run build && node tests/company-pacing.test.cjs",
    "test:dom-interactions": "tsx tests/cdp-browser.test.ts && tsx tests/boss-expectation-editor.test.ts",
    "test:pace-calibration": "node --test tools/manual-pace/calibrate.test.cjs && npm run test:operation-pacing",
    "test:operation-pacing": "tsx tests/boss-action-scheduler.test.ts && tsx tests/cdp-actions.test.ts",
    "test:boss-safety": "npm run build && node tests/boss-safety.test.cjs",
    "test:internal-policy": "npm run build && node tests/internal-policy.test.cjs",
    "test:desktop-worker": "npm run build && node tests/desktop-worker.test.cjs",
    "test:entry": "tsx tests/delivery-entry.test.ts",
    "test:deepseek": "tsx tests/deepseek-web.test.ts",
    "test:deepseek-ui": "tsx tests/deepseek-ui.test.ts",
    "selftest": "tsx tests/selftest.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mammoth": "^1.7.2",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "4.8.69",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "playwright-core": "^1.63.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
