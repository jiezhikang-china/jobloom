{
  "name": "jobloom",
  "version": "1.0.0",
  "description": "拾职 Jobloom — Windows 求职筛选与投递工作台",
  "main": "desktop/electron-main.cjs",
  "scripts": {
    "setup:pdf": "node server/scripts/setup-pdf.cjs",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "desktop:prepare": "npm run build:client && npm run build:server",
    "desktop": "npm run desktop:prepare && electron .",
    "desktop:open": "electron .",
    "test:ui": "node server/tests/claude-ui.test.cjs",
    "test:desktop": "node --test desktop/tests/startup.test.cjs desktop/tests/protocol.test.cjs",
    "start": "cd server && npm start"
  },
  "keywords": [
    "boss-zhipin",
    "playwright",
    "job-hunting",
    "llm",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "38.8.6"
  },
  "productName": "拾职 Jobloom"
}
